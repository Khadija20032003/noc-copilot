# LLM provider: openai or anthropic
LLM_PROVIDER=openai
# Optional: defaults to gpt-4o-mini (openai) or claude-haiku-5-5 (anthropic)
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# DB_PATH=/absolute/path/to/nordtel.db
# TICKETS_PATH=/absolute/path/to/tickets.json
# MAX_STEPS=8
# MAX_REVISIONS=2
# LLM_TEMPERATURE=0

# Frontend (read by Vite from frontend/.env): backend URL
# VITE_API_URL=http://localhost:8000
